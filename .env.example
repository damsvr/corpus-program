# Copie ce fichier en .env puis adapte.
# Base de dev locale (lancée par `npm run db:dev`, Postgres embarqué, aucun Docker requis)
DATABASE_URL="postgresql://corpus:corpus@localhost:5433/corpus"
# Secret de signature des sessions — génère-en un avec : openssl rand -base64 32
AUTH_SECRET="change-me"

# --- Abonnement Stripe (optionnel en dev ; voir docs/business/stripe-setup.md) ---
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_FOUNDER_PRICE_ID=
# Dernier jour d'accès libre, inclus (heure de Bruxelles). Ensuite : abonnement requis.
FREE_ACCESS_UNTIL=2027-01-03
FOUNDER_UNTIL=2027-01-31
FOUNDER_SEATS=30
STRIPE_TRIAL_DAYS=7

# --- Mentions légales affichées sur le site ---
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_BCE=
# false dès que tu quittes le régime de franchise TVA
LEGAL_VAT_FRANCHISE=true
